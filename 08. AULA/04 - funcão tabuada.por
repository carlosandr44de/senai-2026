programa
{
	
	funcao inicio()
	{
		inteiro num
		escreva("Digite o valor: ")
		leia(num)
		tabuada(num)
	}
	funcao tabuada(inteiro n){
	
	para (inteiro mult = 1; mult <= 10; mult++){
     escreva(n * mult,"\n")}
	}
}
