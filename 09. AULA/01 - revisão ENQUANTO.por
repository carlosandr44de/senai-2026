programa
{
	
	funcao inicio()
	{
		cadeia nome
		inteiro cont=1
		escreva("Insira o nome: ")
		leia(nome)

		enquanto(nome !=""){
			escreva("Insira o nome: )
			leia(nome)
			se(nome !=""){
				escreva("Nome inválido!")
			}
		}
	}
}
