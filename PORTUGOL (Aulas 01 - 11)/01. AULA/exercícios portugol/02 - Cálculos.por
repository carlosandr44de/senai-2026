programa {
  funcao inicio() {
    escreva ("Soma: ", 2+4,"\n",
            "Subtração: ",2-4,"\n",
            "Multiplicação: ",2*4,"\n",
            "Divisão: ",4/4,"\n",
            "Resto da divisão: ",4%4,"\n")
    
    inteiro n1
    inteiro n2
    escreva ("Digite um número inteiro: ")
    leia (n1)
    escreva ("Digite outro número inteiro: ")
    leia (n2)
    escreva ("A soma entre ", n1, " e ", n2, " é: ", n1+n2 )
  }
}
