programa
{
	
	funcao inicio()
	{
		inteiro num
		escreva("Digite o número: ")
		leia(num)
		escreva("Resposta: ",multiplicacao(num))
	}
	funcao inteiro multiplicacao(inteiro num){
		retorne num * 10
	}
}
