programa
{
	
	funcao inicio()
	{
		cadeia nome[5]

		para (inteiro i=0; i < 5; i++){
			escreva("Nome: ")
			leia(nome[i])
		}
		escreva("Primeiro nome: \n",nome[0],"\nÚltimo nome: \n",nome[4])
	}
}
