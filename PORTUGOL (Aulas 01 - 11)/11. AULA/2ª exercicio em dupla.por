programa
{
	
	funcao inicio()
	{
		cadeia u, usuarios[4] = {"Cassia", "Foxy", "Eduardo", "Lala"}
		inteiro s, senhas[] = {123, 234, 345, 456}

		para (cadeia u = 0, u < 4, u++){
			escreva("Digite o nome de usuario ")
			leia(u)
		}
			para(inteiro s = 0, s =< 4, s++){
				escreva("Digite a senha do usuario ")
				leia(s)
			}
			
	}
}
